# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lensreel?retryWrites=true&w=majority

# Passcode required to view /admin (bookings dashboard for the studio owner).
# Pick your own value — this is a simple shared-secret gate, not full auth.
ADMIN_PASSCODE=change-me

# Auth.js secret used to sign customer login sessions.
# Generate your own with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-generated-value
